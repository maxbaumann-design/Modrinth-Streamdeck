{
	"Name": "Minecraft Bridge",
	"Version": "1.0.0.0",
	"Author": "Max Baumann",
	"Description": "Control Minecraft from your Stream Deck: game mode, disconnect, commands, screenshots and live ping, FPS and coordinates. Requires the Stream Deck Bridge Fabric mod.",
	"URL": "https://github.com/maxbaumann-design/Modrinth-Streamdeck",
	"Category": "Minecraft Bridge",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24"
	},
	"UUID": "com.maxbaumann.streamdeckbridge",
	"Actions": [
		{
			"Name": "Game Mode",
			"UUID": "com.maxbaumann.streamdeckbridge.gamemode",
			"Icon": "imgs/actions/gamemode/icon",
			"Tooltip": "Switch or cycle the game mode (requires permission on servers).",
			"PropertyInspectorPath": "ui/gamemode.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/gamemode/key",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Disconnect",
			"UUID": "com.maxbaumann.streamdeckbridge.disconnect",
			"Icon": "imgs/actions/disconnect/icon",
